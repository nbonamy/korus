{
  "name": "@workspace/web",
  "version": "0.48.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts && tsc --noEmit -p tsconfig.server.json",
    "dev": "npm run dev:web --prefix ..",
    "start": "node dist/server/index.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "npm run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@codex-app-sdk/web": "0.19.4",
    "@workspace/core": "0.48.0",
    "@workspace/vue": "0.48.0",
    "express": "^5.1.0",
    "vue": "^3.5.35",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
