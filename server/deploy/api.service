[Unit]
Description=__PRODUCT_NAME__ API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__API_SERVICE__
Group=__API_SERVICE__
WorkingDirectory=/opt/__API_SERVICE__/current
EnvironmentFile=/etc/__API_SERVICE__/api.env
ExecStart=/usr/bin/node /opt/__API_SERVICE__/current/api.mjs
Restart=on-failure
RestartSec=5
StateDirectory=__API_SERVICE__
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
CPUQuota=50%
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
