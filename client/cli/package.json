{
  "name": "@workspace/cli",
  "version": "0.51.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node dist/cli.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs plain --noEmit",
    "lint": "node ../../scripts/typecheck.mjs plain --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:package": "node --test build.test.mjs"
  },
  "dependencies": {
    "@workspace/core": "0.51.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
