{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "shasum",
    "swift",
    "spctl"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "website/script.js",
        "website/docs/.vitepress/config.mts",
        "website/docs/.vitepress/theme/index.mts",
        "vite.sdk-aliases.ts",
        "server/scripts/**/*.mjs",
        "server/test/**/*.mjs",
        "server/deploy/container.mjs"
      ],
      "project": [
        "scripts/**/*.mjs",
        "website/**/*.{js,mjs,mts}",
        "*.ts",
        "server/scripts/**/*.mjs",
        "server/test/**/*.mjs"
      ],
      "stylelint": {
        "config": [
          ".stylelintrc.json"
        ]
      }
    },
    "client/electron": {
      "entry": [
        "forge.config.ts",
        "vite.*.config.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/preload/index.ts",
        "src/preload/browser-extensions.ts",
        "src/renderer/main.ts",
        "scripts/*.mjs"
      ]
    },
    "client/backend": {
      "entry": [
        "src/daemon.ts",
        "src/companion/relay-main.ts",
        "src/sharing/guest-probe.ts",
        "src/companion/__tests__/live-harness.ts",
        "src/companion/__tests__/desktop-guest-owner.ts",
        "src/telemetry/__tests__/desktop-stack-workflow.ts"
      ]
    },
    "client/cli": {
      "entry": [
        "src/main.ts",
        "*.mjs"
      ]
    },
    "mobile": {
      "entry": [
        "src/relay-connector.ts",
        "src/companion-state.ts",
        "web/src/engine-main.ts",
        "web/src/transcript-main.ts",
        "web/src/changes-main.ts",
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "web/src/**/*.{ts,vue}",
        "scripts/*.mjs"
      ]
    },
    "client/vue": {
      "entry": [
        "scripts/*.browser.mjs",
        "tests/browser/**/*.browser.spec.mjs",
        "tests/browser/fixtures/**/preview.ts",
        "tests/support/**/*.ts"
      ],
      "ignore": [
        "scripts/fixtures/**"
      ]
    },
    "server/backend": {
      "entry": [
        "src/collector/main.ts"
      ]
    },
    "server/frontend": {
      "entry": [
        "src/main.ts",
        "src/__tests__/report-fixture.ts"
      ]
    }
  }
}
