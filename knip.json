{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["shasum", "swift", "spctl", "openssl"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "website/script.js",
        "website/docs/.vitepress/config.mts",
        "website/docs/.vitepress/theme/index.mts",
        "vite.sdk-aliases.ts"
      ],
      "project": ["scripts/**/*.mjs", "website/**/*.{js,mjs,mts}", "*.ts"],
      "stylelint": {
        "config": [".stylelintrc.json"]
      }
    },
    "electron": {
      "entry": [
        "forge.config.ts",
        "vite.*.config.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/preload/index.ts",
        "src/renderer/main.ts"
      ]
    },
    "web": {
      "entry": ["src/server/index.ts"]
    },
    "backend": {
      "entry": ["src/daemon.ts", "src/companion/relay-main.ts", "src/companion/__tests__/live-harness.ts"]
    },
    "mobile": {
      "entry": ["scripts/*.mjs"],
      "project": ["src/**/*.{ts,vue}", "*.ts", "scripts/*.mjs"]
    }
  }
}
