{
  "name": "@workspace/electron",
  "version": "0.36.3",
  "private": true,
  "description": "Native Codex team desktop app.",
  "main": ".vite/build/main.js",
  "scripts": {
    "prepackage": "node ../scripts/prepare-windows-icon.mjs",
    "premake": "node ../scripts/prepare-windows-icon.mjs",
    "prebuild": "node ../scripts/prepare-windows-icon.mjs",
    "build:computer-use": "node ../scripts/prepare-computer-use.mjs",
    "build:computer-use:local": "node ../scripts/prepare-computer-use.mjs --local",
    "build:tts": "node ../scripts/prepare-tts-helper.mjs",
    "release-notes:check": "node ../scripts/release-notes.mjs check",
    "dev": "node ../scripts/dev.mjs",
    "start": "node ../scripts/start-electron.mjs",
    "package": "npm run build:computer-use && npm run build:tts && npm run prepare:mobile-simulator && electron-forge package",
    "make": "npm run release-notes:check && npm run build:computer-use && npm run build:tts && npm run prepare:mobile-simulator && electron-forge make",
    "check-publish:macos": "node ../scripts/publish-macos.mjs --check-only",
    "build": "npm run build:computer-use && npm run build:tts && npm run prepare:mobile-simulator && tsc --noEmit && electron-forge package",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "prepare:mobile-simulator": "node ../scripts/prepare-mobile-simulator.mjs"
  },
  "dependencies": {
    "@codex-app-sdk/electron": "0.16.2",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@workspace/core": "0.36.3",
    "@workspace/vue": "0.36.3",
    "autolib": "github:nbonamy/witsy-autolib#v1.2.4",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "dotenv": "^17.4.2",
    "electron": "^42.3.0",
    "jsdom": "29.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "build": {
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    }
  }
}
