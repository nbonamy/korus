{
  "name": "@workspace/core",
  "version": "0.57.1",
  "description": "Platform-neutral Application product contracts and state primitives.",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "node ../scripts/typecheck.mjs plain --noEmit",
    "lint": "node ../scripts/typecheck.mjs plain --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@korus-dev/agent-ui-sdk": "0.27.3",
    "@korus-dev/multi-agent-sdk": "0.27.3",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "chart.js": "4.6.1",
    "rrule-temporal": "2.2.8"
  }
}
