{
  "extends": [
    "stylelint-config-recommended",
    "stylelint-config-recommended-vue"
  ],
  "plugins": [
    "@lyliya/stylelint-value-no-unknown-custom-properties",
    "./client/vue/scripts/stylelint-interaction-states.mjs"
  ],
  "overrides": [
    {
      "files": [
        "**/*.vue"
      ],
      "customSyntax": "postcss-html"
    },
    {
      "files": [
        "**/AgentSidebarRepo.vue",
        "**/AgentSidebarActivity.vue"
      ],
      "rules": {
        "lyliya/value-no-unknown-custom-properties": [
          true,
          {
            "importFrom": [
              "src/styles/variables.css",
              "src/styles/theme.css",
              "src/components/agent-sidebar-common.css"
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "lyliya/value-no-unknown-custom-properties": [
      true,
      {
        "importFrom": [
          "src/styles/variables.css",
          "src/styles/theme.css",
          {
            "custom-properties": {
              "--agent-ui-interactive-rest": "initial",
              "--agent-ui-interactive-rest-foreground": "initial",
              "--agent-ui-interactive-hover": "initial",
              "--agent-ui-interactive-hover-foreground": "initial",
              "--agent-ui-interactive-pressed": "initial",
              "--agent-ui-interactive-pressed-foreground": "initial",
              "--agent-ui-interactive-selected": "initial",
              "--agent-ui-interactive-selected-foreground": "initial"
            }
          }
        ]
      }
    ],
    "property-no-unknown": true,
    "unit-no-unknown": true,
    "function-no-unknown": [
      true,
      {
        "ignoreFunctions": [
          "v-bind"
        ]
      }
    ],
    "color-no-invalid-hex": true,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": [
          "deep",
          "global",
          "slotted"
        ]
      }
    ],
    "no-descending-specificity": null,
    "no-empty-source": null,
    "declaration-property-value-no-unknown": null,
    "keyframes-name-pattern": "^(?:(?!.*(?:spin|rotate)).*|app-spin|activity-working-spin|git-operation-feedback-spin|repository-backlog-spin)$",
    "app/interaction-state-owner": true
  }
}
