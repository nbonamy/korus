{
  "name": "@workspace/mobile",
  "version": "0.34.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:native": "swift test --package-path ios --scratch-path .native-build/dictation-tests --jobs 2",
    "test:scroll": "node --test scripts/transcript-scroll.browser.mjs",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@codex-app-sdk/core": "0.16.0",
    "@codex-app-sdk/vue": "0.16.0",
    "@libp2p/circuit-relay-v2": "4.2.14",
    "@libp2p/crypto": "5.1.24",
    "@libp2p/identify": "4.1.15",
    "@libp2p/interface": "3.3.1",
    "@libp2p/peer-id": "6.0.16",
    "@libp2p/websockets": "10.1.22",
    "@multiformats/multiaddr": "13.0.3",
    "@workspace/core": "0.34.0",
    "@workspace/vue": "0.34.0",
    "element-plus": "^2.13.6",
    "libp2p": "3.3.12",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
