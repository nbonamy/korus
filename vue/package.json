{
  "name": "@workspace/vue",
  "version": "0.39.2",
  "description": "Reusable Vue product shell for application hosts.",
  "private": true,
  "type": "module",
  "exports": {
    "./bootstrap": {
      "types": "./src/bootstrap.ts",
      "default": "./src/bootstrap.ts"
    },
    "./platform-api": {
      "types": "./src/platform-api.ts",
      "default": "./src/platform-api.ts"
    },
    "./*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit && npm run lint:css && npm run lint:i18n",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@codex-app-sdk/core": "0.16.5",
    "@codex-app-sdk/vue": "0.16.5",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@tabler/icons-vue": "^3.44.0",
    "@workspace/core": "0.39.2",
    "beautiful-mermaid": "^1.1.3",
    "canvas-confetti": "^1.9.4",
    "element-plus": "^2.13.6",
    "parse-git-diff": "^0.0.20",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "@vue/compiler-dom": "3.5.35",
    "@vue/compiler-sfc": "3.5.35",
    "@vue/test-utils": "2.4.6",
    "jsdom": "29.0.1",
    "stylelint": "^17.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
