{
  "name": "agent-workspace",
  "version": "0.36.2",
  "private": true,
  "packageManager": "npm@10.9.4",
  "overrides": {
    "extract-zip": {
      "yauzl": "^3.4.0"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@libp2p/crypto": "5.1.24",
    "@libp2p/peer-id": "6.0.16",
    "@lyliya/stylelint-value-no-unknown-custom-properties": "^6.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "jsdom": "29.0.1",
    "knip": "6.33.0",
    "playwright": "1.63.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "retimeable-signal": "1.0.1",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4"
  },
  "workspaces": [
    "core",
    "backend",
    "vue",
    "electron",
    "web",
    "mobile"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-relay-timers.mjs",
    "build": "npm run build:electron",
    "build:backend": "npm run build:sdk && npm run build -w @workspace/core && npm run build -w @workspace/backend && node scripts/package-backend.mjs",
    "build:computer-use": "node scripts/prepare-computer-use.mjs",
    "build:computer-use:local": "node scripts/prepare-computer-use.mjs --local",
    "build:electron": "node scripts/build.mjs",
    "build:runtime": "node scripts/prepare-node-runtime.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:tts": "node scripts/prepare-tts-helper.mjs",
    "build:web": "npm run build:sdk && npm run build -w @workspace/backend && npm run build -w @workspace/web",
    "build:website": "npm run docs:build && node website/build.mjs",
    "check-publish:macos": "node scripts/publish-macos.mjs --check-only",
    "daemon:start": "node scripts/daemon-launch-agent.mjs start",
    "daemon:stop": "node scripts/daemon-launch-agent.mjs stop",
    "dev": "npm run dev:electron",
    "dev:backend": "npm run dev -w @workspace/backend",
    "dev:backend:run": "npm run dev:run -w @workspace/backend",
    "dev:backend:serve": "npm run serve -w @workspace/backend",
    "dev:electron": "node scripts/dev.mjs",
    "dev:relay": "node scripts/dev-relay.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "docs:dev": "vitepress dev website/docs --host 127.0.0.1",
    "docs:build": "vitepress build website/docs",
    "docs:preview": "vitepress preview website/docs --host 127.0.0.1",
    "docs:check": "tsc --project website/docs/tsconfig.json && stylelint --config website/docs/.stylelintrc.json 'website/docs/.vitepress/theme/*.css' website/styles.css && prettier --check 'website/docs/.vitepress/**/*.{mts,css}' website/build.mjs website/docs.test.mjs website/navigation.test.mjs",
    "format:vue-styles": "node scripts/format-vue-styles.mjs",
    "format:vue-styles:check": "node scripts/format-vue-styles.mjs --check",
    "lint": "npm run lint:architecture && npm run lint --workspaces && npm run lint:dead-code",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "lint:css": "npm run lint:css -w @workspace/vue",
    "lint:dead-code": "knip",
    "lint:electron": "npm run lint -w @workspace/electron",
    "lint:web": "npm run lint -w @workspace/web",
    "make": "npm run make:electron",
    "make:electron": "npm run build:sdk && npm run build -w @workspace/backend && node scripts/package-backend.mjs && npm run make -w @workspace/electron",
    "package": "npm run package:electron",
    "package:electron": "npm run build:sdk && npm run build -w @workspace/backend && node scripts/package-backend.mjs && npm run package -w @workspace/electron",
    "preview:web": "npm run build:web && npm run start:web",
    "release-notes:check": "node scripts/release-notes.mjs check",
    "release-notes:generate": "node scripts/release-notes.mjs generate",
    "release:build": "node scripts/github-release.mjs build",
    "release:watch": "node scripts/github-release.mjs watch",
    "prerelease": "node scripts/github-release.mjs prerelease",
    "latest": "node scripts/github-release.mjs latest",
    "release:ci-build": "node scripts/macos-keychain.mjs build",
    "start:electron": "npm run start -w @workspace/electron",
    "start:web": "npm run start -w @workspace/web",
    "test": "npm run test --workspaces && npm run test:scripts",
    "test:ai": "npm run test --workspaces -- --silent --reporter=../scripts/vitest-ai-reporter.ts && npm run test:scripts",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:coverage:electron": "npm run test:coverage -w @workspace/electron",
    "test:coverage:web": "npm run test:coverage -w @workspace/web",
    "test:electron": "npm run test -w @workspace/electron",
    "test:integration": "npm test -w @workspace/backend -- sdk-boundary driver-capability-boundary server-conversation-requests server-client-isolation-regressions && npm test -w @workspace/vue -- backend-boundary",
    "test:scripts": "node --test scripts/*.test.mjs vue/scripts/*.test.mjs",
    "test:watch:electron": "npm run test:watch -w @workspace/electron",
    "test:web": "npm run test -w @workspace/web",
    "test:website": "node --test website/site.test.mjs",
    "test:website:browser": "npm run build:website && node --test website/navigation.test.mjs",
    "test:docs": "npm run build:website && node --test website/docs.test.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:electron": "npm run typecheck -w @workspace/electron",
    "typecheck:web": "npm run typecheck -w @workspace/web",
    "verify:github-mcp-token": "node scripts/verify-github-mcp-token.mjs",
    "prepare:mobile-simulator": "node scripts/prepare-mobile-simulator.mjs"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
